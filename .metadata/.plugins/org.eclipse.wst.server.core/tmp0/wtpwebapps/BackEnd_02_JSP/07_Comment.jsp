<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%--
	===========================================================
	07_Comment.jsp  -  주석문(Comment) 3종 비교
	-----------------------------------------------------------
	[실습 방법]
	  브라우저에서 마우스 우클릭 > "페이지 소스 보기(Ctrl+U)" 를 눌러
	  어떤 주석이 클라이언트에게 전달되는지 직접 확인해 보자.
	===========================================================
--%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>주석문</title>
</head>
<body>
	<h2>주석문 3종 비교 (페이지 소스 보기로 확인)</h2>

	<!-- (1) HTML 주석 : 서버가 그대로 전송하므로 클라이언트에게 노출된다. -->

	<%-- (2) JSP 주석 : 변환 단계에서 제거되므로 클라이언트에게 노출되지 않는다. --%>

	<%
		// (3) 자바 주석 : 변환된 Servlet 소스에만 남고 화면/소스에는 노출되지 않는다.
		/* 여러 줄 자바 주석도 마찬가지다. */
	%>

	<ul>
		<li>HTML 주석 &lt;!-- --&gt; : <b>노출됨</b> (비밀은 절대 쓰지 말 것)</li>
		<li>JSP 주석 &lt;%-- --%&gt; : 노출 안 됨 (개발 메모용으로 사용)</li>
		<li>자바 주석 // , /* */ : 노출 안 됨</li>
	</ul>

	<hr>
	<a href="index.html">홈으로</a>
</body>
</html>
